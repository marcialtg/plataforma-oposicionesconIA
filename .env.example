# Variables de entorno de referencia
# Copia este archivo a backend/.env para desarrollo local o configúralas
# en Cloudflare Pages → Settings → Environment variables.

# Autenticación de usuarios
JWT_SECRET=cambia-este-secreto

# Secreto compartido por el cron diario y el endpoint /api/noticias/actualizar
CRON_SECRET=cambia-este-otro-secreto

# --- Agente de noticias ---
NEWS_CURSO=2026-2027
NEWS_DIAS_MAX=365
NEWS_UMBRAL=35
# Permite desactivar la IA (el agente seguirá funcionando con filtros por palabras clave)
NEWS_AI=1
# Número máximo de titulares que revisa la IA por ejecución
NEWS_MAX_IA=45
# Número máximo de noticias que se guardan si la IA está desactivada
NEWS_MAX_SIN_IA=80
# Feeds RSS adicionales separados por comas (opcional)
# NEWS_RSS_EXTRA=https://ejemplo.com/feed.xml
# NEWS_EXTRA_COMUNIDAD=Nacional

# --- IA (la misma que usan los módulos de temario, supuestos, etc.) ---
AI_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Emails de registro (opcional) ---
RESEND_API_KEY=
NOTIFICATION_EMAIL=
